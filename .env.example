# ============================================================
#  Web Event — Konfigurasi Terpusat (template)
#  Salin ke `.env` lalu sesuaikan. JANGAN commit `.env` asli.
#
#  ATURAN: nilai rahasia (DB, JWT, payment key) hanya untuk
#  BACKEND. Kode frontend TIDAK boleh memakainya — bundle
#  frontend bersifat publik.
# ============================================================

# ----------------------------- Backend (Go API) -----------------------------
APP_ENV=development              # development | staging | production
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080
JWT_SECRET=ubah-ini-di-production
JWT_EXPIRY=24h

# ------------------------------- Frontend ----------------------------------
# Hanya nilai NON-rahasia (dipakai orkestrasi/dev, bukan disisipkan ke bundle)
APP_NAME=Web Event
FRONTEND_PORT=5173
FRONTEND_API_BASE_URL=http://localhost:8080/api

# ------------------------------- Database ----------------------------------
DB_DRIVER=postgres               # postgres | mysql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=web_event
DB_USER=web_event
DB_PASSWORD=ubah-ini
DB_SSLMODE=disable

# --------------------------------- Other -----------------------------------
# Domain utama untuk subdomain workspace (website builder)
BASE_DOMAIN=your-event.co.id
# Redis untuk waiting queue (war ticket) — opsional
REDIS_URL=
# Payment gateway bersama (shared) — diisi saat integrasi
PAYMENT_GATEWAY_BASE_URL=
PAYMENT_GATEWAY_SERVER_KEY=
